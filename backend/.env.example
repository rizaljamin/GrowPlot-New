# Set these as Cloud Run secrets/environment variables. Never put provider keys in the APK.
KINDWISE_CROP_HEALTH_API_KEY=
PLANTNET_API_KEY=
# Optional shared app-to-proxy gate. This is not a substitute for authenticated Cloud Run access.
GROWPLOT_PROXY_TOKEN=
# URL and token for the separate YOLO-World inference service.
GROWPLOT_YOLO_SERVICE_URL=
GROWPLOT_YOLO_SERVICE_TOKEN=
# Enable Gemini image analysis on the deployed diagnosis proxy.
GROWPLOT_VERTEX_ENABLED=false
GOOGLE_CLOUD_PROJECT=growplot
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL_ID=gemini-3.5-flash
PORT=8080
