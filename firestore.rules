rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /plots/{plotId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUserId == request.auth.uid
        && plotId.matches(request.auth.uid + '_[A-Za-z0-9_-]+');
      // All authenticated users may view plots; only owners may delete.
      allow read: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.ownerUserId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid;
    }
    match /data_feeds/{deviceId} {
      allow read: if request.auth != null
        && resource.data.ownerUserId == request.auth.uid;
      allow create: if request.auth != null
        && deviceId.matches(request.auth.uid + '_[A-Za-z0-9_-]+')
        && request.resource.data.ownerUserId == request.auth.uid
        && !request.resource.data.keys().hasAny(['credentials','password']);
      allow update: if request.auth != null
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['credentials','password','ownerUserId']);
      allow delete: if request.auth != null
        && resource.data.ownerUserId == request.auth.uid;
    }
    match /feed_assignments/{assignmentId} {
      allow read: if request.auth != null
        && resource.data.ownerUserId == request.auth.uid;
      // A signed-in owner may pair only an existing owned plot and device.
      allow create: if request.auth != null
        && assignmentId.matches(request.auth.uid + '_[A-Za-z0-9_-]+')
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUserId','plotId','greenhouseId','sectionId','deviceId','updatedAt'])
        && request.resource.data.plotId is string
        && request.resource.data.deviceId is string
        && request.resource.data.greenhouseId.matches('greenhouse-[1-9][0-9]*')
        && request.resource.data.sectionId.matches('section-[1-9][0-9]*')
        && assignmentId == request.auth.uid + '_' + request.resource.data.plotId + '_' + request.resource.data.greenhouseId + '_' + request.resource.data.sectionId + '_' + request.resource.data.deviceId
        && get(/databases/$(database)/documents/plots/$(request.auth.uid + '_' + request.resource.data.plotId)).data.ownerUserId == request.auth.uid
        && get(/databases/$(database)/documents/data_feeds/$(request.auth.uid + '_' + request.resource.data.deviceId)).data.ownerUserId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if request.auth != null && resource.data.ownerUserId == request.auth.uid;
    }
    // Plot-video grants are created, listed and revoked only through authenticated
    // Cloud Functions that verify the plot owner and intended viewer.
    // Client reads and writes are denied, including collection queries.
    match /plot_video_grants/{grantId} {
      allow read, write: if false;
    }
    match /users/{uid}/data_feeds/{deviceId} {
      allow read, write: if false;
    }
    match /users/{uid} {
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'USER'
        && request.resource.data.email == request.auth.token.email;
      // Admin directory access is based on a server-issued custom claim.
      // A profile's editable role field must never grant administrator rights.
      allow get: if request.auth != null && (
        request.auth.uid == uid || request.auth.token.admin == true
      );
      allow list: if request.auth != null && request.auth.token.admin == true;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }
  }
}
